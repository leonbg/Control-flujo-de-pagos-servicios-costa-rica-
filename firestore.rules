rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCategory(val) {
      return val is string && val in ['rent', 'tuition', 'services', 'subscriptions', 'other'];
    }

    function isValidRecurrence(val) {
      return val is string && val in ['one_time', 'monthly', 'bimonthly', 'quarterly', 'semester', 'annual'];
    }

    function isValidMethod(val) {
      return val is string && val in ['transfer', 'credit_card', 'debit_card', 'cash', 'direct_debit'];
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll(['uid', 'currency', 'language', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'currency', 'language', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.currency is string
        && data.currency in ['CRC', 'USD', 'EUR']
        && data.language is string
        && data.language in ['es', 'en']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPaymentRule(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'payee',
          'category',
          'amount',
          'dueDate',
          'recurrence',
          'method',
          'autopay',
          'paused',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'payee',
          'category',
          'amount',
          'dueDate',
          'recurrence',
          'method',
          'autopay',
          'paused',
          'reference',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.payee is string
        && data.payee.size() >= 1
        && data.payee.size() <= 120
        && isValidCategory(data.category)
        && (data.amount is int || data.amount is float)
        && data.amount > 0
        && data.amount <= 100000000
        && isValidDateString(data.dueDate)
        && isValidRecurrence(data.recurrence)
        && isValidMethod(data.method)
        && data.autopay is bool
        && data.paused is bool
        && (!('reference' in data) || (data.reference is string && data.reference.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPaymentLog(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'payee',
          'category',
          'amountPaid',
          'dueDate',
          'paidDate',
          'method',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'ruleId',
          'title',
          'payee',
          'category',
          'amountPaid',
          'dueDate',
          'paidDate',
          'method',
          'notes',
          'createdAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && (!('ruleId' in data) || isValidId(data.ruleId))
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.payee is string
        && data.payee.size() >= 1
        && data.payee.size() <= 120
        && isValidCategory(data.category)
        && (data.amountPaid is int || data.amountPaid is float)
        && data.amountPaid > 0
        && data.amountPaid <= 100000000
        && isValidDateString(data.dueDate)
        && isValidDateString(data.paidDate)
        && isValidMethod(data.method)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['currency', 'language', 'updatedAt']);
      allow delete: if false;

      match /rules/{ruleId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(ruleId);
        allow list: if isOwner(userId)
          && isValidId(userId)
          && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(ruleId)
          && isValidPaymentRule(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId))
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(ruleId)
          && isValidPaymentRule(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'payee',
              'category',
              'amount',
              'dueDate',
              'recurrence',
              'method',
              'autopay',
              'paused',
              'reference',
              'notes',
              'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly(['dueDate', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['paused', 'updatedAt'])
          );
        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(ruleId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }

      match /logs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow list: if isOwner(userId)
          && isValidId(userId)
          && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(logId)
          && isValidPaymentLog(incoming(), userId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId))
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(logId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }
  }
}
